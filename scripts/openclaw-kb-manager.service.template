[Unit]
Description=OpenClaw Knowledge Base Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@OPENCLAW_DIR@:@SYSTEM_PATH@
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_DIR@/.venv/bin/uvicorn --env-file @ENV_FILE@ backend.main:app --host 0.0.0.0 --port @PORT@ --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
