APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# External mount prefix when served behind a reverse proxy sub-path,
# e.g. APP_BASE_PATH=/kb-manage for http://<host>/kb-manage/
APP_BASE_PATH=
# Set to false when the site is reached over plain http (e.g. http://ip:port),
# otherwise browsers refuse the Secure session cookie and login cannot stick.
APP_COOKIE_SECURE=
APP_DATA_DIR=./runtime
# Default directory for public knowledge bases (indexed by every agent)
PUBLIC_KB_PATH=~/.openclaw/kb/public
APP_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-use
OPENCLAW_BIN=openclaw
OPENCLAW_CONFIG_PATH=
OPENCLAW_TIMEOUT_SECONDS=3600
MAX_UPLOAD_BYTES=52428800
MAX_CONVERSION_OUTPUT_BYTES=104857600
SESSION_TTL_SECONDS=86400
APP_START_WORKER=true
