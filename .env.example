APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./runtime
APP_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-use
OPENCLAW_BIN=openclaw
OPENCLAW_CONFIG_PATH=
OPENCLAW_AGENT_WORKSPACE_ROOT=~/.openclaw/kb-workspaces
OPENCLAW_TIMEOUT_SECONDS=3600
MAX_UPLOAD_BYTES=52428800
MAX_CONVERSION_OUTPUT_BYTES=104857600
SESSION_TTL_SECONDS=86400
APP_START_WORKER=true
